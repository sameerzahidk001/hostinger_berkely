.env
.env.*
!.env.example

# Laravel / PHP
/vendor/
/node_modules/
/public/hot
/public/storage
/storage/*.key
/storage/app/public/
/storage/app/private/
/storage/app/preserved-public-uploads/
/storage/debugbar/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
.sucuriquarantine/

# Build artifacts
*.log
*.tmp
*.bak
php_errorlog
tmp-*
tmp*.txt
tmp*.css
tmp*.html
tmp*.json
user-behavior/

# Database dumps / exports
*.sql
!database/*.sql
!database/sql/*.sql
database/live-to-sublive-content-sync.sql
*.sqlite
*.sqlite3
# User-uploaded media — do not push these. Hostinger git deploy overwrites
# tracked files and git-clean deletes untracked ones. Keep uploads only on
# the server (and in ../persistent-uploads), not in GitHub.
# Do NOT ignore all of /public — CSS, JS, and frontend assets must still deploy.
/public/admin/courses/**
!/public/admin/courses/.gitkeep
!/public/admin/courses/course.png
!/public/admin/courses/cma1.jpeg
!/public/admin/courses/cma2.jpeg
/public/images/profiles/**
!/public/images/profiles/.gitkeep
!/public/images/profiles/user.png
/public/images/library/**
!/public/images/library/.gitkeep
/public/images/clients/**
!/public/images/clients/.gitkeep

