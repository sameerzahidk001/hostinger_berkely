APP_NAME="BERKELEYME"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://test.berkeleyme.com
# If CSS/JS still break, uncomment next line (or set document root to /public in hPanel):
# ASSET_URL=https://test.berkeleyme.com/public

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=

# Noon Payments (live: api.noonpayments.com / test: api-test.noonpayments.com)
NOON_BUSINESS_ID=
NOON_APP_ID=
NOON_APP_KEY=
NOON_AUTH_KEY=
NOON_AUTH_SCHEME=
NOON_MODE=live
NOON_API_URL=https://api.noonpayments.com/payment/v1
NOON_ORDER_CATEGORY=pay
NOON_CHANNEL=web
NOON_CURRENCY=AED
NOON_PAYMENT_ACTION=SALE
NOON_WEBHOOK_SECRET=

RAKBANK_MERCHANT_ID=
RAKBANK_API_PASSWORD=
# RakBank checkout always settles in AED (display currency may differ on invoices)
RAKBANK_CHECKOUT_CURRENCY=AED
