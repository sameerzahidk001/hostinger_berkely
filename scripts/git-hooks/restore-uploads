#!/bin/bash
# Restore course/profile/library uploads after git checkout/merge/reset.
# Hostinger auto-deploy uses git reset --hard, which would otherwise delete
# files that are no longer in the repository.

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
HOOK_SCRIPT="$ROOT/scripts/preserve-public-uploads.sh"

if [ -f "$HOOK_SCRIPT" ]; then
  # shellcheck source=/dev/null
  . "$HOOK_SCRIPT"
  restore_uploads
fi
