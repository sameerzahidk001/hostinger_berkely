<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Hostinger/WAF can block large CMS page POST bodies (plain "Forbidden").
<IfModule mod_security2.c>
    SecRule REQUEST_URI "@rx ^/admin/pages" "id:1999,phase:1,nolog,pass,ctl:ruleEngine=Off"
    SecRule REQUEST_URI "@rx ^/admin/course/[0-9]+/update" "id:2000,phase:1,nolog,pass,ctl:ruleEngine=Off"
    SecRule REQUEST_URI "@rx ^/user" "id:2002,phase:1,nolog,pass,ctl:ruleEngine=Off"
</IfModule>
<IfModule security2_module>
    SecRule REQUEST_URI "@rx ^/admin/pages" "id:1999,phase:1,nolog,pass,ctl:ruleEngine=Off"
    SecRule REQUEST_URI "@rx ^/admin/course/[0-9]+/update" "id:2000,phase:1,nolog,pass,ctl:ruleEngine=Off"
    SecRule REQUEST_URI "@rx ^/user" "id:2002,phase:1,nolog,pass,ctl:ruleEngine=Off"
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prefer apex host. Check Host and CDN/proxy forwarded host (Hostinger may normalize Host).
    RewriteCond %{HTTP:X-Forwarded-Host} ^www\.(eduberkeley\.com|berkeleyschool\.org)$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^www\.(eduberkeley\.com|berkeleyschool\.org)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Student portal is a Laravel route. A leftover public/user folder would 403
    # because directory indexes are off — send /user to the app first.
    RewriteRule ^user(/.*)?$ public/index.php [L]

    # Redirect mistaken /public/admin/ URL to Laravel admin login
    RewriteRule ^public/admin/?$ admin/login [R=302,L]

    # Serve static files from /public when web root is the Laravel project root (Hostinger)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(avif|webp|jpe?g|png|gif)$">
        Header always set Vary "Accept"
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
</IfModule>
AddHandler application/x-httpd-php82 .php .php5 .php4 .php3
AddHandler application/x-httpd-php82 .php .php5 .php4 .php3
